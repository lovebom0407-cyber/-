# GEMINI_API_KEY: Required for Gemini AI API calls.
# Local / Serverless (Netlify): Configure as GEMINI_API_KEY or VITE_GEMINI_API_KEY in Netlify Site configuration -> Environment variables
GEMINI_API_KEY="your_gemini_api_key_here"

# (Optional) VITE_GEMINI_API_KEY: If set in Netlify, also accessible to client-side
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
